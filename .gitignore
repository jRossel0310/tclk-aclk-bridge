# Python venv
.venv/
__pycache__/
*.pyc
# pytest scratch. It self-ignores (pytest writes a .gitignore inside), but listing
# it here means that still holds if the directory is ever created another way.
.pytest_cache/

# Simulation build artifacts & waveforms
sim_build/
*.fst
*.fst.hier
*.vcd
results.xml

# Vivado build artifacts (the bitstream flow). Source stays tracked
# (build*.tcl, uart_echo_bd.tcl); generated outputs are ignored.
# /build/ is the repo-local default (./build/kria/<name>); build-manifest.json
# lives under it and is intentionally ignored (it is a build output).
/build/
vivado/build/
vivado/*.log
vivado/*.jou
.Xil/
*.str

# Stray GUI-created Vivado projects (use the scripted vivado/ flow instead).
project_1/
*.xpr

# Compiled/loadable deploy artifacts. The deploy/ SOURCES (.dts/.bif/.json/.py)
# ARE tracked; these generated outputs are not.
*.dtbo
*.bit.bin
*.bit

# GT Wizard IP generated synthesis XML (large); keep .xci + .veo
vivado/ip/**/*.xml
vivado/ip/*.log
vivado/ip/*.jou
vivado_*.backup.jou
vivado_*.backup.log
vivado/ip/aclkgt_gt/aclkgt_gt.bmj
vivado/ip/aclkgt_gt/aclkgt_gt.vho
vivado/ip/aclkgt_gt/aclkgt_gt_bmstub.v
vivado/ip/aclkgt_gt/hdl/
vivado/ip/aclkgt_gt/synth/

# Superpowers SDD scratch (task briefs, reports, progress ledger): on-disk only, not part of the repo
.superpowers/

# --- repo cleanup (2026-07-01) ---
# Root-level Vivado logs (vivado/*.log covers the subdir; these are repo-root)
/vivado.jou
/vivado.log
# Stray GUI GT-configuration Vivado project (use the scripted vivado/ip flow)
gt_configuration/
# GT IP generated products (regenerated from the tracked aclkgt_gt.xci)
vivado/ip/_ref_*.veo.ports
vivado/ip/aclkgt_gt/*.dcp
vivado/ip/aclkgt_gt/*_sim_netlist.*
vivado/ip/aclkgt_gt/*_stub.*
vivado/ip/aclkgt_gt/doc/
vivado/ip/aclkgt_gt/sim/
vivado/ip/aclkgt_gt_[0-9]*/
# Generated HTML render of the hardware-interface guide (keep the .md + .pdf)
docs/generated/*.html

# VS Code: ignore personal editor config, keep the shared task/extension files
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json

poster/
# capture-analysis artifacts (data pulled from the board + generated figures)
deploy/events-*.csv
deploy/overnight-*.csv
deploy/sc_*.svg
deploy/sc_*.png
paper/

# Board-side run artifacts. The board runs the pipeline from a CLONE of this repo
# (deploy/ is the working directory), so everything the publisher, archiver and QA
# tools write lands in the working tree. Without these, `git status` on the board is
# permanently dirty and `git clean` would delete live capture data.
deploy/stats-*.jsonl
deploy/archive-state.json
deploy/archive-state.json.tmp
deploy/flags-*.csv
# wr_time.py guard appends here on every lock transition, so a multi-day run leaves
# one of these in the working tree. No .log file in deploy/ is tracked.
deploy/*.log
# generated figures only, named explicitly so a blanket deploy/*.png cannot
# silently skip a figure someone later decides to commit
deploy/marker_timing.png
deploy/faithfulness.png
deploy/plot-*.png
deploy/pps-*.png
deploy/*_hist.png
deploy/*_raster.png
# supercycle_plot.py writes <stem>_hist.svg + <stem>_raster.svg. deploy/sc_*.svg
# below only catches the -o sc_*.svg naming; the default stem is supercycle.
deploy/*_hist.svg
deploy/*_raster.svg

# archives of captures or artifacts staged for a pscp transfer
*.tar.gz

# internal working docs: kept locally, not published in this repo
docs/superpowers
docs/MAINTAINER_GUIDE.md
docs/PIPELINE_REPORT.md
docs/PIPELINE_REPORT.pdf
docs/wr-reference-findings.md
docs/wr-reference-investigation.md
docs/generated/

# publication material lives outside this repo's remit; 2026-08-05 these were
# briefly swept into a commit when .gitignore itself got deleted: never again
paper/
poster/

docs/generated
docs/superpowers

pps-live.log
pps-live.png


# Capture data and figures pulled off the board into the repo root. One pattern
# per line: a missing newline here once let an 827 MB CSV into a commit, and the
# CSV rule said .png, so neither file was actually ignored.
day-*.png
events-tclk-*.csv
events-*.csv